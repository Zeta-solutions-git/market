# Ocean Enterprise Marketplace .env template — dotsp-1.vm.bit.nl
#
# TEMPLATE, not the real .env. Claude never reads/echoes real .env files —
# merge into ~/oe/market/.env by hand and fill in every _FILL_ME_ yourself.
#
# IMPORTANT: every NEXT_PUBLIC_* variable is a Next.js build-time public var —
# it is inlined into the JavaScript bundle shipped to every browser. None of
# these may be localhost or an internal-only address; they must all be
# reachable from the visitor's browser. Values below assume the nginx
# path-based routing plan (pending your confirmation) — see chat.

# --- OE Node (path-routed at https://dotsp-1.vm.bit.nl/node/) ---
# This market is v1.5.0 (>=1.4.1): per docs, NEXT_PUBLIC_METADATACACHE_URI must
# be a JSON array, not a bare string, on this version. NEXT_PUBLIC_NODE_URI_INDEXED
# is documented as a JSON array in every version. NEXT_PUBLIC_PROVIDER_URL stays a
# single string (the default node used for writes/publishing).
NEXT_PUBLIC_PROVIDER_URL=https://dotsp-1.vm.bit.nl/node/
NEXT_PUBLIC_METADATACACHE_URI=["https://dotsp-1.vm.bit.nl/node/"]
NEXT_PUBLIC_NODE_URI_INDEXED=["https://dotsp-1.vm.bit.nl/node/"]

# --- Blockchain RPC ---
# Per-chain URI map (JSON) and default. Fill with the networks this
# deployment targets — see Supported Networks in the OE docs.
NEXT_PUBLIC_NODE_URI_MAP=_FILL_ME_
NEXT_PUBLIC_NODE_URI=_FILL_ME_

# --- IPFS ---
NEXT_PUBLIC_IPFS_GATEWAY=_FILL_ME_
NEXT_PUBLIC_IPFS_UPLOAD_URL=_FILL_ME_
NEXT_PUBLIC_IPFS_DELETE_URL=_FILL_ME_
IPFS_JWT=_FILL_ME_
NEXT_PUBLIC_IPFS_UNPIN_FILES=false

# --- Currencies & Fees ---
NEXT_PUBLIC_ALLOWED_ERC20_ADDRESSES=_FILL_ME_
NEXT_PUBLIC_CONSUME_MARKET_ORDER_FEE_MAP=_FILL_ME_
NEXT_PUBLIC_CONSUME_MARKET_FEE=_FILL_ME_
NEXT_PUBLIC_MARKET_FEE_ADDRESS=_FILL_ME_

# --- SSI (path-routed) ---
NEXT_PUBLIC_SSI_ENABLED=true
NEXT_PUBLIC_SSI_POLICY_SERVER=https://dotsp-1.vm.bit.nl:8002
NEXT_PUBLIC_SSI_WALLET_API=https://dotsp-1.vm.bit.nl/ssi-wallet-api/
NEXT_PUBLIC_SSI_UI_URL=https://dotsp-1.vm.bit.nl/ssi-wallet-ui/
NEXT_PUBLIC_OPA_SERVER_URL=https://dotsp-1.vm.bit.nl/opa/
NEXT_PUBLIC_SSI_DEFAULT_POLICIES_URL=_FILL_ME_

# --- Dataspace & Auth ---
NEXT_PUBLIC_DATASPACE=_FILL_ME_
NEXT_PUBLIC_AUTH_ENABLED=false
# If you enable market-level auth (NEXT_PUBLIC_AUTH_ENABLED=true), see the
# "Configure market-level authentication" docs and fill these:
# NEXT_PUBLIC_AUTH_PROVIDER=_FILL_ME_
# NEXT_PUBLIC_OIDC_ISSUER=_FILL_ME_
# NEXT_PUBLIC_OIDC_CLIENT_ID=_FILL_ME_
# OIDC_CLIENT_SECRET=_FILL_ME_
# NEXT_PUBLIC_CENTRAL_IDP_NAME=_FILL_ME_
# NEXT_PUBLIC_OIDC_SIGNUP_FLOW=_FILL_ME_
# NEXT_PUBLIC_OIDC_REDIRECT_URI=_FILL_ME_
# NEXT_PUBLIC_OIDC_TOKEN_URL=_FILL_ME_

# --- Legal docs (optional, blank = default market copy) ---
# NEXT_PUBLIC_IMPRINT_URL=_FILL_ME_
# NEXT_PUBLIC_TC_URL=_FILL_ME_
# NEXT_PUBLIC_PP_URL=_FILL_ME_
# NEXT_PUBLIC_CP_URL=_FILL_ME_
# NEXT_PUBLIC_DPUA_URL=_FILL_ME_

# --- Analytics (optional) ---
# NEXT_PUBLIC_POSTHOG_HOST=_FILL_ME_
# NEXT_PUBLIC_POSTHOG_KEY=_FILL_ME_

# --- Misc ---
NEXT_PUBLIC_ENCRYPT_ASSET=true
NEXT_PUBLIC_HIDE_ONBOARDING_MODULE_BY_DEFAULT=false
NEXT_PUBLIC_PRIVACY_PREFERENCE_CENTER=false
